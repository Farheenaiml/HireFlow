# ---- LLM provider (optional). Without a key HireFlow uses its local evidence engine.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---- n8n orchestration (optional)
N8N_BASE_URL=
N8N_API_KEY=
USE_N8N=false

# Seconds to wait between candidates when an LLM is configured (rate limits)
SCREEN_DELAY=2

# ---- Security (optional). When set, n8n must send X-Internal-Key on helper routes.
INTERNAL_KEY=

# ---- Reliability
LLM_MAX_RETRIES=3
LLM_RETRY_BASE=1.5

# ---- Storage
HIREFLOW_DB=hireflow.db
